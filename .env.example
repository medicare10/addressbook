# Copy to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (DB name can be set via MONGODB_DB)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net
# Optional: database name (defaults to "addressbook")
MONGODB_DB=addressbook

# Secret for signing JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: API port (defaults to 3001)
PORT=3001
